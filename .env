# --- client.py ---
# IP address or hostname of the machine running server.py
TARGET=PXITC006778

# Number of parallel FETCH connections the client opens to download files
CLIENT_WORKERS=4

# Set to 1 to use a "HallFileShareClient" folder instead of "HallFileShare".
# Handy when running client and server on the same machine for testing.
TEST_CLIENT=0

# --- server.py ---
# Size of the thread pool used for blocking disk reads
SERVER_THREADS=4

# Set to 1 to use a "HallFileShareServer" folder instead of "HallFileShare".
# Handy when running client and server on the same machine for testing.
TEST_SERVER=0